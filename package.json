{
  "name": "trade-imports-frontend-tests",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "engines": {
    "node": "25.9.0"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "aliases": {
    "~": ".",
    "page-objects": "test/page-objects",
    "components": "test/components"
  },
  "scripts": {
    "clean": "rm -rf allure-results && rm -rf allure-report && rm -rf reports",
    "test:accessibility": "npm run clean && wdio run wdio.local.conf.js --spec test/specs/accessibility.e2e.js",
    "test:cdp:browserstack": "npm run clean && wdio run wdio.browserstack.cdp.conf.js",
    "test:local": "npm run clean && wdio run wdio.local.conf.js",
    "test:local:debug": "npm run clean && DEBUG=true wdio run wdio.local.conf.js",
    "test:local:browserstack": "npm run clean && wdio run wdio.browserstack.conf.js",
    "format": "prettier --write 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "format:check": "prettier --check 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "git:pre-commit-hook": "npm run format:check && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npm run setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "report": "allure generate allure-results --clean && node -e \"import('./allure-accessibility-plugin/allure-accessibility-integration.js').then(m => m.integrateAccessibilityWithAllure())\"",
    "report:open": "npm run report && allure open allure-report",
    "report:publish": "npm run report && ./bin/publish-tests.sh"
  },
  "dependencies": {
    "@azure/logger": "1.3.0",
    "@azure/service-bus": "7.9.5",
    "@wdio/allure-reporter": "9.27.1",
    "@wdio/browserstack-service": "9.27.1",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/junit-reporter": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/visual-service": "6.3.3",
    "allure-commandline": "2.40.0",
    "dotenv": "16.5.0",
    "esm-module-alias": "2.2.1",
    "global-agent": "3.0.0",
    "https-proxy-agent": "9.0.0",
    "proxy-agent": "8.0.1",
    "undici": "8.2.0",
    "uuid": "14.0.0",
    "winston": "3.19.0",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-wdio": "8.24.12",
    "husky": "9.1.7",
    "prettier": "3.5.3"
  },
  "overrides": {
    "ajv": "^6.14.0",
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "axios": "^1.15.2",
    "browserstack-local": "^1.5.9",
    "cheerio": {
      "undici": "^7.24.0"
    },
    "diff": "^8.0.4",
    "file-type": "^21.3.1",
    "flatted": "^3.4.2",
    "glob": "^10.5.0",
    "ip-address": "^10.1.1",
    "jest-message-util": {
      "picomatch": "^4.0.4"
    },
    "jest-util": {
      "picomatch": "^4.0.4"
    },
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.0",
    "minimatch": "^3.1.4",
    "mocha": {
      "minimatch": "^5.1.8",
      "picomatch": "^2.3.2"
    },
    "readdir-glob": {
      "minimatch": "^5.1.8"
    },
    "serialize-javascript": "^7.0.5",
    "tar-fs": "^3.1.1",
    "tmp": "^0.2.4",
    "yauzl": "^3.2.1"
  }
}
